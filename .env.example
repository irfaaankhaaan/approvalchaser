# Copy to .env.local and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Postgres. Supabase, Neon, RDS or a local server — anything that speaks
# Postgres. Leave it BLANK in local development and the app runs an in-process
# Postgres (PGlite) under .pgdata instead, so you need no database to start.
# It is required in production; the app refuses to boot without it.
DATABASE_URL=postgresql://user:password@host:5432/approvalchaser?sslmode=require

# The public origin of this deployment. Client approval links are built from
# it, so it has to be the address a client's browser can actually reach.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
# From api.slack.com/apps > your app > Basic Information.

SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Any long random string. Signs the OAuth `state` parameter (the CSRF guard on
# install) and the short-lived agency links.
#   openssl rand -base64 32
SLACK_STATE_SECRET=

# Encrypts Slack bot tokens before they are written to the database.
# Must be exactly 32 bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# From resend.com/api-keys. Leave blank in development and emails are printed
# to the terminal instead of sent, with the approval link included so you can
# click it. Production refuses to start without it.
RESEND_API_KEY=

# Must be an address on a domain you have verified with Resend.
EMAIL_FROM="Northlight Studio <approvals@yourdomain.com>"

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Shared secret for /api/cron. Vercel Cron sends it as a Bearer token.
# Without it the endpoint would be a public button that emails every client.
#   openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Reminder wording. With no key the deterministic templates are used, which is
# a complete implementation — nothing stops working without this.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# How long a client approval link stays usable. Default 30 days.
# APPROVAL_TOKEN_TTL_DAYS=30
